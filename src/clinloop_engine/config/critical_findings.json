{
  "name": "ClinLoop default critical imaging findings",
  "basis": "ACR Practice Parameter for Communication of Diagnostic Imaging Findings (2020): Category 1 = critical (communicate within minutes), Category 2 = urgent (within hours). Example list only: each hospital must review, edit and approve its own list before clinical use.",
  "findings": [
    {"id": "explicit_critical", "category": 1, "window_minutes": 60,
     "label": {"en": "Report states a critical result", "ko": "판독문에 위급 결과 명시"},
     "patterns": ["critical (?:result|finding)", "위급\\s*(?:소견|결과)"]},
    {"id": "pulmonary_embolism", "category": 1, "window_minutes": 60,
     "label": {"en": "Acute pulmonary embolism", "ko": "급성 폐색전증"},
     "patterns": ["pulmonary (?:embolism|emboli|embolus)", "saddle embol\\w*", "폐색전증"]},
    {"id": "aortic_dissection", "category": 1, "window_minutes": 60,
     "label": {"en": "Aortic dissection or intramural haematoma", "ko": "대동맥 박리"},
     "patterns": ["aortic dissection", "intramural h(?:a)?ematoma", "대동맥\\s*박리"]},
    {"id": "ruptured_aneurysm", "category": 1, "window_minutes": 60,
     "label": {"en": "Ruptured or leaking aortic aneurysm", "ko": "대동맥류 파열"},
     "patterns": ["(?:ruptured|leaking) (?:abdominal )?aortic aneurysm", "(?:ruptured|leaking)\\s+(?:[\\w.]+\\s+){0,4}?(?:AAA|aneurysm)\\b",
                  "\\bAAA\\b(?:(?!\\b(?:no|not|without|negative)\\b)[^.;]){0,30}?\\b(?:rupture[ds]?|leak(?:ing|age)?)\\b", "대동맥류\\s*파열"]},
    {"id": "intracranial_haemorrhage", "category": 1, "window_minutes": 60,
     "label": {"en": "Intracranial haemorrhage", "ko": "두개내 출혈"},
     "patterns": ["intracranial h(?:a)?emorrhage", "(?:subarachnoid|subdural|epidural|intraparenchymal) h(?:a)?(?:emorrhage|ematoma)",
                  "뇌출혈", "두개내\\s*출혈", "지주막하\\s*출혈", "경막하\\s*혈종",
                  "뇌(?:내|실내|실질내)\\s*출혈", "경막(?:외|하)\\s*(?:출혈|혈종)",
                  "\\b(?:SDH|EDH|SAH|ICH|IVH|IPH)\\b"]},
    {"id": "acute_stroke", "category": 1, "window_minutes": 30,
     "label": {"en": "Acute infarct or large-vessel occlusion", "ko": "급성 뇌경색·대혈관 폐색"},
     "patterns": ["acute (?:ischemic )?infarct\\w*", "large[- ]vessel occlusion",
                  "acute (?:\\w+\\s+){0,4}?(?:arter\\w*|vessel|MCA|ICA|M1|M2|basilar|carotid|vertebral|cerebral)\\s+(?:\\w+\\s+){0,2}?occlu(?:sion|ded)",
                  "acute occlu(?:sion|ded) of the (?:\\w+\\s+){0,3}?(?:MCA|ICA|M1|M2|basilar|carotid|vertebral|(?:middle|anterior|posterior) cerebral)",
                  "\\b(?:M1|M2)\\b[^.;]{0,25}?occlu(?:sion|ded)", "급성\\s*뇌경색",
                  "(?:뇌동맥|경동맥|기저동맥|척추동맥|M1|M2)[^.]{0,20}?급성\\s*폐색"]},
    {"id": "pneumothorax", "category": 1, "window_minutes": 60,
     "label": {"en": "Pneumothorax (new)", "ko": "기흉"},
     "patterns": ["(?:tension )?pneumothorax", "기흉"]},
    {"id": "free_air", "category": 1, "window_minutes": 60,
     "label": {"en": "Free intraperitoneal air", "ko": "복강내 유리 공기"},
     "patterns": ["pneumoperitoneum", "free (?:intraperitoneal )?air", "기복증", "복강내\\s*유리\\s*공기"]},
    {"id": "torsion", "category": 1, "window_minutes": 60,
     "label": {"en": "Testicular or ovarian torsion", "ko": "고환·난소 염전"},
     "patterns": ["(?:testicular|ovarian|adnexal) torsion", "(?:고환|난소)\\s*염전"]},
    {"id": "cord_compression", "category": 1, "window_minutes": 60,
     "label": {"en": "Spinal cord compression", "ko": "척수 압박"},
     "patterns": ["cord compression", "척수\\s*압박"]},
    {"id": "malpositioned_tube", "category": 1, "window_minutes": 60,
     "label": {"en": "Malpositioned endotracheal or feeding tube", "ko": "튜브 위치 이상"},
     "patterns": ["(?:endotracheal|feeding|nasogastric|enteric) tube (?:is |terminates |lies )?(?:in|within) the (?:right |left )?(?:main(?:stem)? )?bronch\\w*",
                  "malpositioned (?:endotracheal|feeding|nasogastric|enteric) tube"]},
    {"id": "bowel_obstruction", "category": 2, "window_minutes": 360,
     "label": {"en": "Bowel obstruction", "ko": "장폐색"},
     "patterns": ["(?:small[- ]bowel|large[- ]bowel|bowel) obstruction", "장폐색"]},
    {"id": "appendicitis", "category": 2, "window_minutes": 360,
     "label": {"en": "Acute appendicitis", "ko": "급성 충수염"},
     "patterns": ["acute appendicitis", "급성\\s*충수염"]}
  ]
}
